<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.DashboardFragment">

    <LinearLayout
        android:id="@+id/llLinear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:padding="4dp"
        android:orientation="vertical">


        <TextView
            android:id="@+id/marqueeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="10dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/seek_bar_progress"
            android:background="@color/line_background2"
            android:text="Please update leads within the define timeline otherwise it will reversed!!"
            style="@style/subtitle1"
            />

        <TextView
            style="@style/subtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:background="@color/line_background1"
            android:text="@string/upcoming_events_for_today"
            android:textColor="@color/done_text_color_normal"
            android:textStyle="bold"/>

        <!--            <TextView-->
        <!--                style="@style/subtitle1"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="wrap_content"-->
        <!--                android:gravity="center"-->
        <!--                android:padding="6dp"-->
        <!--                android:layout_marginStart="6dp"-->
        <!--                android:layout_marginEnd="6dp"-->
        <!--                android:textColor="@color/white"-->
        <!--                android:background="@drawable/button_gradient"-->
        <!--                android:layout_weight="0.5"-->
        <!--                android:text="Create New Lead"-->
        <!--                android:textStyle="bold"/>-->


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@color/line_background2"
            android:weightSum="1">

            <androidx.cardview.widget.CardView
                android:id="@+id/followUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                android:padding="10dp"
                android:layout_margin="6dp"
                android:layout_weight="0.5"
                app:cardCornerRadius="4dp">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp">
                    <TextView
                        android:id="@+id/followUpCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_24"
                        android:textStyle="bold"
                        android:text="0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/followUpCount"
                        android:text="FOLLOW UP"
                        style="@style/subtitle1" />
                </RelativeLayout>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:cardElevation="4dp"
                android:padding="10dp"
                android:layout_margin="6dp"
                android:layout_weight="0.5"
                app:cardCornerRadius="4dp">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:padding="6dp">
                    <TextView
                        android:id="@+id/checkIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/subtitle1"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:text="Check In"/>

                    <TextView
                        android:id="@+id/checkOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/checkIn"
                        android:textColor="@color/colorPrimary"
                        android:text="Check out"
                        android:textStyle="bold"
                        android:visibility="gone"
                        style="@style/subtitle1" />
                </RelativeLayout>

            </androidx.cardview.widget.CardView>

<!--            <Button-->
<!--                style="@style/button"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_gravity="center_vertical"-->
<!--                android:layout_marginStart="10dp"-->
<!--                android:layout_weight="0.2"-->
<!--                android:background="@drawable/button_gradient"-->
<!--                android:padding="6dp"-->
<!--                android:text="create new lead"-->
<!--                android:textColor="@color/white" />-->

        </LinearLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/done_text_color_normal"
                android:paddingLeft="8dp"
                android:layout_marginTop="10dp"
                style="@style/subtitle1"
                 android:background="@color/line_background1"
                android:textStyle="bold"
                android:text="Total Lead Status"/>
        
        <ScrollView
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    android:padding="4dp"
                    app:cardBackgroundColor="@color/line_background2"
                    app:cardCornerRadius="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewLeadSummary"
                        android:layout_width="match_parent"
                        tools:listitem="@layout/lead_list_count"
                        android:layout_height="wrap_content">
                    </androidx.recyclerview.widget.RecyclerView>
                </androidx.cardview.widget.CardView>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/done_text_color_normal"
                    android:paddingLeft="8dp"
                    android:layout_marginTop="10dp"
                    style="@style/subtitle1"
                    android:textStyle="bold"
                    android:background="@color/line_background1"
                    android:text="@string/today_status" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/line_background2"
                    app:cardCornerRadius="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewTodayLead"
                        android:layout_width="match_parent"
                        tools:listitem="@layout/lead_list_count"
                        android:layout_height="wrap_content">
                    </androidx.recyclerview.widget.RecyclerView>

                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/createNewLeads"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/add_icon"
        android:padding="10dp"
        android:background="@drawable/tab_background_gradient"
        app:tint="@color/white"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>