<!--    -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc1"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>
