<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    tools:context="propfinsolutions.realstate.app.com.propfinsolutions.ui.SplashActivity">


    <ImageView
        android:id="@+id/logo"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:src="@drawable/logo"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Your Mobile No."
        style="@style/headline6"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        />


    <LinearLayout
        android:layout_centerInParent="true"
        android:id="@+id/line1"
        android:orientation="horizontal"
        android:layout_width="230sp"
        android:layout_centerHorizontal="true"
        android:layout_height="40dp">


        <propfinsolutions.realstate.app.com.propfinsolutions.spiner.CountrySpinner
            android:id="@+id/spinner"
            android:layout_width="100dp"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"/>



    </LinearLayout>
   <EditText
        android:id="@+id/etLoginMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="10-digit No."
        android:textSize="@dimen/text_size_20"
        android:padding="@dimen/activity_horizontal_margin"
        android:maxLength="10"
        android:digits="0123456789"
        android:inputType="number"
        android:textScaleX="1"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm your Mobile No. for SMS Authentication"
        style="@style/caption"
        android:gravity="center_horizontal"
        />
    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnLoginSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textColor="@color/white"
           style="@style/button"
            android:textStyle="bold"
            android:background="@drawable/button_gradient"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            />
        
        <ProgressBar
            android:id="@+id/sendOtpProgress"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:visibility="gone"
            />
        
    </FrameLayout>

</LinearLayout>
