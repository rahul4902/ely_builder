<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="10"
    >

    // code start
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#fff"
                android:padding="16dp"
                >
                // #NAME
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal"
                        android:textColor="@color/app_color"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETName"
                        style="@style/subtitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Name"
                        />
                </LinearLayout>
                // #CONTACT No.
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact Number"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETContactNo"
                        android:inputType="phone"
                        android:maxLength="10"
                        style="@style/subtitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Mobile"
                        />
                </LinearLayout>
                // #EMAIL
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETEmail"
                        style="@style/subtitle2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Email"
                        />
                </LinearLayout>
                // #CITY
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Country"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETCountry"
                        style="@style/subtitle2"
                        android:inputType="text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Country"
                        />
                </LinearLayout>

                // #STATE
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="State"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETState"
                        style="@style/subtitle2"
                        android:inputType="text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter State"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="City"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETCity"
                        style="@style/subtitle2"
                        android:inputType="text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter City"
                        />
                </LinearLayout>
                // #PINCODE
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pincode"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETPincode"
                        android:inputType="number"
                        style="@style/subtitle2"
                        android:maxLength="6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Pincode"
                        />
                </LinearLayout>

                // #SOURCE
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Source"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <Spinner
                        android:id="@+id/idSPNSource"
                        android:layout_width="match_parent"
                        style="@style/subtitle2"
                        android:layout_height="wrap_content"
                        />
                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/other_source"
                        android:hint="Other Source"
                        style="@style/subtitle2"
                        android:inputType="text"
                        android:visibility="gone"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                // #LOCATIONS
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <EditText
                        android:id="@+id/idETLocations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Location"
                        style="@style/subtitle2"
                        />
                </LinearLayout>
                // #PROJECT
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Project"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <Spinner
                        android:id="@+id/idSPNProject"
                        android:layout_width="match_parent"
                        style="@style/subtitle2"
                        android:layout_height="wrap_content"
                        />
                    <EditText
                        android:id="@+id/other_project"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Project"
                        style="@style/subtitle2"
                        android:inputType="text"
                        android:visibility="gone"
                        />
                </LinearLayout>
                // #REQUIREMENT
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Requirement"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <Spinner
                        android:id="@+id/idSPNRequirement"
                        android:layout_width="match_parent"
                        style="@style/subtitle2"
                        android:layout_height="wrap_content"
                        />
                    <EditText
                        android:id="@+id/other_requirement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your Requirement"
                        android:inputType="text"
                        style="@style/subtitle2"
                        android:visibility="gone"
                        />
                </LinearLayout>
                // #BUDGET
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Budget"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <Spinner
                        android:id="@+id/idSPNBudget"
                        android:layout_width="match_parent"
                        style="@style/subtitle2"
                        android:layout_height="wrap_content"
                        />
                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/other_budge"
                        android:hint="Your Budge"
                        android:inputType="text"
                        style="@style/subtitle2"
                        android:visibility="gone"
                        android:layout_height="wrap_content" />

                </LinearLayout>
                // #STATUS
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lead Type"
                        android:textColor="@color/app_color"
                        style="@style/subtitle2"
                        android:padding="5dp"
                        android:textStyle="normal" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_color"/>
                    <Spinner
                        android:id="@+id/idSPNLeadType"
                        android:layout_width="match_parent"
                        style="@style/subtitle2"
                        android:layout_height="wrap_content"
                        />

                    <Button
                        android:id="@+id/idBtnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Submit"
                        android:layout_marginTop="25dp"
                        android:textColor="@color/white"
                         android:background="@drawable/button_gradient"
                        android:layout_marginLeft="64dp"
                        android:layout_marginRight="64dp"
                        style="@style/button"
                        />

                </LinearLayout>

                // Code End
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
