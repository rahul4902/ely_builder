<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="2dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Name and Tag Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- Name Text -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pratiush Singh"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/numberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7905400000"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_weight="1"/>

        <!-- Platinum Tag -->
<!--        <TextView-->
<!--            android:id="@+id/tagText"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="PLATINUM"-->
<!--            android:textColor="@android:color/white"-->
<!--            android:background="@drawable/tab_background_gradient"-->
<!--            android:paddingHorizontal="8dp"-->
<!--            android:paddingVertical="2dp"-->
<!--            style="@style/caption"/>-->

    </LinearLayout>

    <!-- Location Text -->

    <TextView
        android:id="@+id/projectText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aditya World City (Main)"
        android:textColor="#8A8A8A"
        style="@style/subtitle2"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/cityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aditya World City (Main)"
        android:textColor="#8A8A8A"
        style="@style/subtitle2"
        android:layout_marginTop="2dp" />

    <!-- Follow Up Text -->
    <TextView
        android:id="@+id/followUpText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4CAF50"
        style="@style/body2"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/meetingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4CAF50"
        style="@style/body2"
        android:layout_marginTop="4dp"/>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:weightSum="4">

        <!-- Arrow Button -->
        <ImageButton
            android:id="@+id/arrowButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:src="@drawable/ic_arrow_forward_white_24dp" />

        <!-- Calendar Button -->
        <ImageButton
            android:id="@+id/calendarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:src="@drawable/calendar_icon"
            app:tint="@color/colorPrimary" />

        <!-- Chat Button -->
        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:src="@drawable/chat_icon"
            />

        <!-- Call Button -->
        <ImageButton
            android:id="@+id/callButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:src="@drawable/call_icon" />
    </LinearLayout>

</LinearLayout>
</androidx.cardview.widget.CardView>