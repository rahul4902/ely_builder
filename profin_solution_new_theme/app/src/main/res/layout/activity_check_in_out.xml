<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.checkIn.CheckInOutActivity">

  <include
      android:id="@+id/toolbar"
      layout="@layout/toolbar" />

  <ScrollView
      android:layout_width="match_parent"
      android:fillViewport="true"
      android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:weightSum="3"
        android:background="@color/clock_background"
        android:orientation="vertical"
        android:layout_height="match_parent">


      <propfinsolutions.realstate.app.com.propfinsolutions.ui.checkIn.MyAnalogClock
          android:id="@+id/clock"
          android:layout_gravity="center"
          android:gravity="center"
          android:background= "@color/clock_background"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_centerInParent="true"
          android:layout_margin="60dp"
          android:layout_weight="0.4"
          />
      <TextClock
          android:id="@+id/digitalClock1"
          android:layout_width="wrap_content"
          android:format24Hour="hh:mm a"
          android:format12Hour="@null"
          android:layout_height="wrap_content"
          android:layout_below="@+id/analogClock1"
          android:layout_centerHorizontal="true"
          android:layout_gravity="center"
          android:textStyle="bold"
          android:textSize="30dp"
          android:textColor="@color/white"
          android:layout_marginBottom="10dp"
          android:text="DigitalClock"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <LinearLayout
          android:layout_weight="1.3"
          android:layout_width="match_parent"
          android:orientation="horizontal"
          android:weightSum="2"
          android:layout_height="match_parent">
        <TextView
            android:layout_weight="1.3"
            android:text="Remark   :"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:singleLine="true"
            android:background="@drawable/diolog"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            android:textSize="20dp"
            />

        <EditText
            android:layout_weight="0.7"
            android:hint="Enter text here.."
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/edUserRemark"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:textAllCaps="true"
            android:maxLines="1"
            android:inputType="text"
            android:background="@drawable/diolog"
            android:layout_gravity="center"
            android:textAlignment="textStart"
            android:textColor="@color/done_text_color_normal"
            android:textStyle="bold"
            style="@style/subtitle1"
            tools:ignore="RtlCompat" />

      </LinearLayout>



      <TextView
          android:layout_weight="1.3"
          android:text="Check in"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:id="@+id/tvcheckin"
          android:gravity="center"
          android:layout_gravity="center"
          android:textAlignment="center"
          android:textColor="@color/white"
          android:textStyle="bold"
          style="@style/headline6"
          android:background="@drawable/circle">
      </TextView>

      <TextView
          android:layout_weight="1.3"
          android:text="Check out"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:id="@+id/tvcheckOut"
          android:gravity="center"
          android:visibility="gone"
          android:layout_gravity="center"
          android:textAlignment="center"
          android:textColor="@color/white"
          android:textStyle="bold"
          style="@style/headline6"
          android:background="@drawable/circle"
          >

      </TextView>

    </LinearLayout>
  </ScrollView>

  </LinearLayout>